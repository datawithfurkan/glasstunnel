{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glasstunnel.io/schemas/factory-node-v1.json",
  "title": "Glasstunnel Factory Node v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "nonGoals",
    "surfaces",
    "fileOwnership",
    "risk",
    "budgets",
    "resources",
    "validation",
    "maxEvidenceFreeAttempts",
    "humanGates",
    "evidence"
  ],
  "properties": {
    "schema": { "const": "glasstunnel.factory.node.v1" },
    "objective": { "type": "string", "minLength": 1 },
    "nonGoals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "parentEpic": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "mac",
          "web-mobile",
          "protocol",
          "relay",
          "auth",
          "deploy",
          "documentation",
          "factory"
        ]
      }
    },
    "fileOwnership": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallClockMinutes", "modelTokens", "githubRuns"],
      "properties": {
        "wallClockMinutes": { "type": "integer", "minimum": 1 },
        "modelTokens": { "type": "integer", "minimum": 0 },
        "githubRuns": { "type": "integer", "minimum": 0, "maximum": 1 },
        "externalApiDollars": { "type": "number", "minimum": 0 }
      }
    },
    "resources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "maxEvidenceFreeAttempts": { "type": "integer", "minimum": 0, "maximum": 1 },
    "humanGates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "proposed",
        "specified",
        "ready",
        "claimed",
        "implementing",
        "locally_verified",
        "reviewed",
        "integration_ready",
        "ci_verified",
        "accepted",
        "blocked",
        "replan_required",
        "rejected",
        "cancelled"
      ]
    }
  }
}
