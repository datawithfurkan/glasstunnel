{
  "name": "@glasstunnel/shared-crypto",
  "version": "0.1.0-dev",
  "private": true,
  "description": "ed25519 signing and verification helpers shared between the PWA and the signaling layer",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
