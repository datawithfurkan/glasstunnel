{
  "name": "glasstunnel",
  "version": "0.1.0-dev",
  "private": true,
  "description": "Open-source tunnel from a local Mac running AI coding agents to a mobile PWA",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "workspaces": [
    "apps/cloudflare-signal",
    "apps/mobile-pwa",
    "packages/protocol",
    "packages/shared-crypto",
    "site"
  ],
  "scripts": {
    "proto:gen": "bash packages/protocol/scripts/gen.sh",
    "build": "pnpm -r --filter=@glasstunnel/protocol --filter=@glasstunnel/shared-crypto --filter=@glasstunnel/cloudflare-signal --filter=@glasstunnel/mobile-pwa --filter=@glasstunnel/site build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:pwa": "pnpm --filter=@glasstunnel/mobile-pwa dev",
    "dev:site": "pnpm --filter=@glasstunnel/site dev",
    "dev:cloudflare-signal": "wrangler dev --cwd apps/cloudflare-signal --config wrangler.jsonc",
    "dev:signaling": "pnpm dev:signaling:legacy",
    "dev:signaling:legacy": "cd apps/signaling && PORT=18080 go run ./cmd/server",
    "dev:stack": "pnpm lab:up",
    "lab:doctor": "node scripts/lab/cli.mjs doctor",
    "lab:up": "node scripts/lab/cli.mjs up",
    "lab:up:host": "node scripts/lab/cli.mjs up-host",
    "lab:status": "node scripts/lab/cli.mjs status",
    "lab:reset": "node scripts/lab/cli.mjs reset",
    "lab:down": "node scripts/lab/cli.mjs down",
    "lab:mac": "node scripts/lab/cli.mjs mac",
    "lab:test": "pnpm lab:test:unit && pnpm worker:typecheck && pnpm worker:test",
    "lab:test:unit": "node --test scripts/lab/*.test.mjs",
    "lab:e2e": "node scripts/lab/e2e.mjs chromium",
    "lab:e2e:codex-cli": "node scripts/lab/e2e.mjs codex-cli-chromium",
    "lab:e2e:safari": "node scripts/lab/e2e.mjs webkit",
    "lab:e2e:screen": "node scripts/lab/e2e.mjs screen-chromium",
    "lab:e2e:screen:safari": "node scripts/lab/e2e.mjs screen-webkit",
    "worker:build": "pnpm --filter @glasstunnel/cloudflare-signal build",
    "worker:test": "pnpm --filter @glasstunnel/cloudflare-signal test",
    "worker:typecheck": "pnpm --filter @glasstunnel/cloudflare-signal typecheck",
    "agent:validate": "bash scripts/agent-validate.sh",
    "agent:validate:run": "bash scripts/agent-validate.sh --run",
    "qa:goal-loop-log": "bash scripts/check-release-goal-loop-log.sh",
    "qa:goal-loop-log:smoke": "bash scripts/release-goal-loop-log-smoke.sh",
    "notify:telegram:blocker": "bash scripts/notify-telegram-blocker.sh",
    "notify:telegram:blocker:dry-run": "GT_TELEGRAM_DRY_RUN=1 bash scripts/notify-telegram-blocker.sh",
    "notify:telegram:chat-id": "bash scripts/telegram-chat-id.sh",
    "qa:manual-release-gates": "bash scripts/check-manual-release-gates.sh",
    "qa:manual-release-gates:smoke": "bash scripts/manual-release-gates-smoke.sh",
    "release:readiness": "bash scripts/release-readiness.sh",
    "release:readiness:mobile": "bash scripts/release-readiness.sh --mobile",
    "release:readiness:published": "bash scripts/release-readiness.sh --github",
    "release:github-state": "bash scripts/github-release-state.sh",
    "release:github-state:strict": "bash scripts/github-release-state.sh --strict",
    "release:mac:preflight": "bash scripts/mac-release-preflight.sh",
    "qa:mac-permission-onboarding": "bash scripts/mac-permission-onboarding-audit.sh",
    "qa:mac-lifecycle": "bash scripts/mac-lifecycle-truthfulness-audit.sh",
    "qa:mac:live": "bash scripts/record-mac-live-evidence.sh",
    "qa:mac:live:check": "bash scripts/check-mac-live-evidence.sh",
    "qa:mac:live:record-smoke": "bash scripts/mac-live-evidence-recorder-smoke.sh",
    "qa:mac:distribution-docs": "bash scripts/mac-distribution-docs-audit.sh",
    "qa:mac:cask-audit": "bash scripts/homebrew-cask-audit.sh",
    "qa:mac:cask-update": "bash scripts/homebrew-cask-update-smoke.sh",
    "qa:mac:cask-install": "bash scripts/homebrew-cask-local-install-smoke.sh",
    "qa:mac:notarization": "bash scripts/mac-notarization-smoke.sh",
    "qa:security-privacy": "bash scripts/security-privacy-audit.sh",
    "qa:public-repo": "node scripts/public-repository-audit.mjs",
    "qa:secrets:history": "gitleaks git --no-banner --redact=100 --config .gitleaks.toml --log-opts=HEAD .",
    "release:mac:install-smoke": "bash scripts/mac-install-upgrade-smoke.sh",
    "release:agent-apps": "bash scripts/release-agent-apps.sh",
    "qa:local-apps": "bash scripts/local-app-availability.sh",
    "qa:local-apps:smoke": "bash scripts/local-app-availability-smoke.sh",
    "qa:codex-state": "bash scripts/codex-state-audit.sh",
    "qa:codex-state:labels": "CODEX_AUDIT_REQUIRE_LABEL_SOURCES=1 bash scripts/codex-state-audit.sh",
    "qa:codex-state:smoke": "bash scripts/codex-state-audit-smoke.sh",
    "qa:codex-cli": "bash scripts/codex-cli-smoke.sh",
    "qa:codex-cli:runtime": "bash scripts/codex-cli-runtime-smoke.sh",
    "qa:codex-cli:hosted-chrome": "bash scripts/codex-cli-hosted-chrome-smoke.sh",
    "qa:hosted-cli:contracts": "bash scripts/check-hosted-cli-smoke-contracts.sh && bash scripts/check-gemini-hosted-smoke-contract.sh",
    "qa:hosted-cli:evidence": "bash scripts/check-hosted-cli-evidence-artifacts.sh",
    "qa:hosted-cli:evidence-smoke": "bash scripts/hosted-cli-evidence-artifacts-smoke.sh",
    "qa:codex-cli:terminal-app-tui": "bash scripts/codex-cli-terminal-app-tui-smoke.sh",
    "qa:codex-cli:terminal-app-switch-tui": "bash scripts/codex-cli-terminal-app-switch-tui-smoke.sh",
    "qa:codex-cli:ios-safari-recovery": "bash scripts/codex-cli-ios-safari-recovery-smoke.sh",
    "qa:codex-cli:ios-safari-prompt": "bash scripts/codex-cli-ios-safari-prompt-smoke.sh",
    "qa:claude-code": "bash scripts/claude-code-smoke.sh",
    "qa:claude-code:terminal-app-onboarding-tui": "bash scripts/claude-code-terminal-app-onboarding-tui-smoke.sh",
    "qa:gemini-cli": "bash scripts/gemini-cli-smoke.sh",
    "qa:gemini-cli:terminal-app-auth-tui": "bash scripts/gemini-cli-terminal-app-auth-tui-smoke.sh",
    "qa:gemini-cli:hosted-chrome": "bash scripts/gemini-cli-hosted-chrome-smoke.sh",
    "qa:gemini-cli:hosted-contract": "bash scripts/check-gemini-hosted-smoke-contract.sh",
    "qa:gemini-cli:ios-safari-prompt": "bash scripts/gemini-cli-ios-safari-prompt-smoke.sh",
    "qa:opencode-cli": "bash scripts/opencode-cli-smoke.sh",
    "qa:opencode:sessions": "bash scripts/opencode-session-store-audit.sh",
    "qa:opencode:terminal-app-tui": "bash scripts/opencode-cli-terminal-app-tui-smoke.sh",
    "qa:opencode:terminal-app-switch-tui": "bash scripts/opencode-cli-terminal-app-switch-tui-smoke.sh",
    "qa:opencode:terminal-app-interrupt-tui": "bash scripts/opencode-cli-terminal-app-interrupt-tui-smoke.sh",
    "qa:opencode:desktop-install-upgrade": "bash scripts/opencode-desktop-install-upgrade-smoke.sh",
    "qa:opencode:hosted-chrome": "bash scripts/opencode-hosted-chrome-smoke.sh",
    "qa:opencode:hosted-chrome-blocked-model": "GT_OPENCODE_HOSTED_EXPECT_MODEL_BLOCKED=1 GT_OPENCODE_HOSTED_MODEL=opencode/gpt-5-nano bash scripts/opencode-hosted-chrome-smoke.sh",
    "qa:opencode:hosted-chrome-session-switch": "GT_OPENCODE_HOSTED_SESSION_SWITCH=1 bash scripts/opencode-hosted-chrome-smoke.sh",
    "qa:opencode:ios-safari-recovery": "bash scripts/opencode-ios-safari-recovery-smoke.sh",
    "qa:opencode:ios-safari-prompt": "bash scripts/opencode-ios-safari-prompt-smoke.sh",
    "qa:opencode:ios-safari-session-switch": "GT_OPENCODE_IOS_SESSION_SWITCH=1 bash scripts/opencode-ios-safari-prompt-smoke.sh",
    "qa:remote-app-logs": "bash scripts/remote-app-log-tail.sh",
    "qa:cursor-state": "bash scripts/cursor-state-audit.sh",
    "qa:cursor:project-path-truth": "GT_CURSOR_STATE_REQUIRE_PROJECT_PATH_TRUTH=1 bash scripts/cursor-state-audit.sh",
    "qa:cursor:label-source-availability": "GT_CURSOR_STATE_REQUIRE_LABEL_SOURCE_AVAILABILITY=1 bash scripts/cursor-state-audit.sh",
    "qa:cursor:live-state": "bash scripts/cursor-live-state-snapshot.sh",
    "qa:cursor:label-truth": "GT_CURSOR_STATE_REQUIRE_LABEL_TRUTH=1 bash scripts/cursor-live-state-snapshot.sh",
    "qa:cursor:model-settings-ax": "bash scripts/cursor-model-settings-ax-audit.sh",
    "qa:cursor:model-settings-storage": "bash scripts/cursor-model-settings-storage-audit.sh",
    "qa:cursor:deeplink-prefill": "bash scripts/cursor-deeplink-prefill-smoke.sh",
    "qa:cursor:open-surfaces": "bash scripts/cursor-open-surfaces-audit.sh",
    "qa:cursor:target-opening-truth": "GT_CURSOR_OPEN_SURFACES_REQUIRE_TARGET_TRUTH=1 bash scripts/cursor-open-surfaces-audit.sh",
    "qa:cursor:workspace-prompt-policy": "bash scripts/check-cursor-workspace-prompt-policy.sh",
    "qa:cursor:agent-cli": "bash scripts/cursor-agent-cli-audit.sh",
    "qa:cursor:agent-account": "bash scripts/cursor-agent-account-audit.sh",
    "qa:cursor:agent-prompt": "bash scripts/cursor-agent-prompt-smoke.sh",
    "qa:cursor:agent-resume": "bash scripts/cursor-agent-resume-smoke.sh",
    "qa:cursor:agent-edit": "bash scripts/cursor-agent-edit-probe.sh",
    "qa:cursor:agent-hosted-chrome": "bash scripts/cursor-agent-hosted-chrome-smoke.sh",
    "qa:cursor:agent-hosted-chrome-ask-mode": "GT_CURSOR_AGENT_HOSTED_ASK_MODE_PREFLIGHT=1 bash scripts/cursor-agent-hosted-chrome-smoke.sh",
    "qa:cursor:agent-hosted-chrome-stop": "GT_CURSOR_AGENT_HOSTED_STOP_RECOVERY=1 bash scripts/cursor-agent-hosted-chrome-smoke.sh",
    "qa:cursor:visible-history": "bash scripts/cursor-visible-history-smoke.sh",
    "qa:cursor:non-current-truth": "GT_CURSOR_VISIBLE_HISTORY_REQUIRE_NON_CURRENT_TRUTH=1 bash scripts/cursor-visible-history-smoke.sh",
    "qa:cursor:hosted-chrome": "bash scripts/cursor-hosted-chrome-smoke.sh",
    "qa:cursor:hosted-chrome:background": "GT_CURSOR_HOSTED_BACKGROUND_BEFORE_SUBMIT=1 bash scripts/cursor-hosted-chrome-smoke.sh",
    "qa:cursor:hosted-chrome:preflight": "GT_CURSOR_HOSTED_PREFLIGHT_ONLY=1 bash scripts/cursor-hosted-chrome-smoke.sh",
    "qa:cursor:hosted-chrome:target-switch": "GT_CURSOR_HOSTED_TARGET_SWITCH_ONLY=1 bash scripts/cursor-hosted-chrome-smoke.sh",
    "qa:cursor:ios-safari-preflight": "GT_CURSOR_IOS_PREFLIGHT_ONLY=1 bash scripts/cursor-ios-safari-prompt-smoke.sh",
    "qa:cursor:ios-safari:background-preflight": "GT_CURSOR_IOS_BACKGROUND_PREFLIGHT_ONLY=1 bash scripts/cursor-ios-safari-prompt-smoke.sh",
    "qa:cursor:ios-safari-prompt": "bash scripts/cursor-ios-safari-prompt-smoke.sh",
    "qa:cursor:agent-ios-safari-prompt": "GT_CURSOR_IOS_REMOTE_APP_ID=cursor-agent bash scripts/cursor-ios-safari-prompt-smoke.sh",
    "qa:terminal": "bash scripts/terminal-smoke.sh",
    "qa:terminal:live": "node scripts/terminal-live-relay-diagnostic.mjs",
    "qa:terminal:live:smoke-account": "bash scripts/terminal-live-smoke-account.sh",
    "qa:terminal:live:linked-smoke-account": "bash scripts/terminal-live-smoke-account-linked-host.sh",
    "qa:terminal:hosted-chrome": "bash scripts/terminal-hosted-chrome-smoke.sh",
    "qa:terminal:ios-safari": "bash scripts/terminal-ios-safari-smoke.sh",
    "qa:terminal:ios-safari-command": "bash scripts/terminal-ios-safari-command-smoke.sh",
    "qa:terminal:ios-safari-session": "bash scripts/terminal-ios-safari-session-smoke.sh",
    "qa:terminal:rendered-start": "bash scripts/terminal-rendered-start-smoke.sh",
    "qa:terminal:app-continuity": "bash scripts/terminal-app-continuity-smoke.sh",
    "qa:terminal:screen-sessions": "bash scripts/terminal-screen-session-cleanup-smoke.sh && bash scripts/terminal-screen-session-cleanup.sh",
    "qa:agent-app:record": "bash scripts/record-agent-app-evidence.sh",
    "qa:agent-app-claims": "bash scripts/check-agent-app-release-claims.sh",
    "qa:agent-app-claims:smoke": "bash scripts/agent-app-release-claims-smoke.sh",
    "qa:screen-state": "bash scripts/screen-state-smoke.sh",
    "qa:mobile:real": "bash scripts/record-real-mobile-qa.sh",
    "qa:mobile:real:record-smoke": "bash scripts/mobile-evidence-recorder-smoke.sh",
    "qa:mobile:real:check": "bash scripts/check-real-mobile-evidence.sh",
    "qa:mobile:horizontal-scroll": "bash scripts/mobile-horizontal-scroll-smoke.sh",
    "qa:mobile:workspace-fixture": "bash scripts/mobile-workspace-fixture-smoke.sh",
    "qa:mobile:chrome-fixture": "bash scripts/mobile-chrome-fixture-smoke.sh",
    "release:cask": "bash scripts/update-homebrew-cask.sh",
    "qa:mobile:ios": "bash scripts/mobile-ios-smoke.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6"
    }
  }
}
