<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>GlassTunnel</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>io.glasstunnel.host</string>
    <key>CFBundleName</key>
    <string>Glasstunnel</string>
    <key>CFBundleDisplayName</key>
    <string>Glasstunnel</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.5</string>
    <key>CFBundleVersion</key>
    <string>5</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2026 The Glasstunnel Authors. Licensed under Apache 2.0.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- In-app updates (Sparkle). build-app.sh adds SUPublicEDKey to release
         builds only; without it the app sends people to GitHub Releases. -->
    <key>SUFeedURL</key>
    <string>https://glasstunnel.io/appcast.xml</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
    <key>NSAccessibilityUsageDescription</key>
    <string>Glasstunnel uses Accessibility to type the prompts you send from your browser into your coding agents, and to click and type on this Mac when you control Mac Screen remotely.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Glasstunnel captures this Mac's screen or the windows you pick and streams them to your signed-in browsers when you open Mac Screen there.</string>
</dict>
</plist>
