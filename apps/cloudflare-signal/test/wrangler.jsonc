{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "glasstunnel-signal-test",
  "main": "../src/index.ts",
  "compatibility_date": "2026-04-19",
  "vars": {
    "PUBLIC_APP_URL": "http://127.0.0.1:5173",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_HUB",
        "class_name": "SignalingHub",
      },
      {
        "name": "RELAY_HUB",
        "class_name": "RelayHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingHub"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayHub"],
    },
  ],
}
