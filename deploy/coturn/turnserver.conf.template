# coturn configuration for glasstunnel self-hosting.
#
# Start with this template and fill in the placeholders wrapped in
# __VARS__. When running the deploy/compose.yml all-in-one stack, the
# Dockerfile for coturn renders this template from environment variables.

listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
realm=__TURN_REALM__
server-name=__TURN_SERVER_NAME__
user=__TURN_USER__:__TURN_PASSWORD__

# Bandwidth caps per user session. Tune up if you host Pro tier users.
max-bps=2000000
bps-capacity=0
total-quota=100
user-quota=50

no-loopback-peers
no-multicast-peers
stale-nonce=600

# TLS is strongly recommended for production. Provide cert + key paths
# and uncomment the next block if you have them.
#cert=/etc/coturn/cert.pem
#pkey=/etc/coturn/key.pem
#no-tcp
#no-tls

# Logging: tune via docker logs, not files.
log-file=stdout
verbose
